{
  "version": "physiocircuit-bench-v1",
  "note": "Dual-track IDAR results. Edge-IDAR = named mechanism edits on graph-bearing systems; input-IDAR = controlled input-level counterfactuals on edge-less systems. Same DA/TA/joint formula and same intervention instances; channels are not pooled.",

  "protocol": {
    "formula": {
      "DA": "1/N sum 1[d_i == d_hat_i]",
      "TA": "1/N sum 1[t_i in W_i]",
      "IDAR": "1/N sum 1[d_i == d_hat_i AND t_i in W_i]",
      "non_response": "counts as failure on both DA and TA"
    },
    "channels": {
      "edge_id": "Named mechanism edit (delete/replace/reverse/extend-lag/inject-wrong/mask-evidence) on an existing graph edge.",
      "input_id": "Same intervention descriptor supplied as a natural-language counterfactual to an edge-less model; no internal edge assumed. Measures response alignment, not edge recovery."
    },
    "no_universal_chance_level": true,
    "no_1_3_baseline": true,
    "n_interventions_per_system": {
      "digestive": 180,
      "pneumonia": 210,
      "cardio_sepsis": 190
    },
    "temperature": 0,
    "runs_per_config": 3,
    "bootstrap": "paired cluster bootstrap over intervention instances, 20000 resamples"
  },

  "edge_idar_topology": {
